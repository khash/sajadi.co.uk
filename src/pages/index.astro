---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { site, sections, socials } from '../data/site';
---

<Layout>
  <div class="mx-auto w-full max-w-2xl px-6 py-16 sm:py-24">
    <header class="flex items-start justify-between gap-6">
      <div>
        <h1 class="font-serif text-5xl tracking-tight text-stone-900 sm:text-6xl dark:text-stone-100">{site.name}</h1>
        <p class="mt-4 max-w-md text-base/7 text-pretty text-stone-600 dark:text-stone-400">{site.bio}</p>
      </div>
      <ThemeToggle class="shrink-0" />
    </header>

    {sections.map((section) => (
      <section class="mt-16">
        <h2 class="font-mono text-xs tracking-widest text-stone-500 uppercase dark:text-stone-500">{section.title}</h2>
        <ul role="list" class="mt-4 divide-y divide-stone-200 border-y border-stone-200 dark:divide-stone-800 dark:border-stone-800">
          {section.links.map((link) => (
            <li>
              <a href={link.href} class="group flex items-baseline justify-between gap-6 py-5">
                <div>
                  <p class="font-serif text-2xl text-stone-900 transition-colors group-hover:text-orange-800 dark:text-stone-100 dark:group-hover:text-orange-400">
                    {link.name}
                  </p>
                  <p class="mt-1 text-sm text-stone-600 dark:text-stone-400">{link.note}</p>
                </div>
                <span class="shrink-0 font-mono text-xs text-stone-500 transition-colors group-hover:text-orange-800 dark:group-hover:text-orange-400">
                  {link.host} <span aria-hidden="true">↗</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <footer class="mt-16 flex flex-wrap items-center justify-between gap-4 text-sm text-stone-500 dark:text-stone-400">
      <p>England &amp; California</p>
      <ul role="list" class="flex gap-6">
        {socials.map((s) => (
          <li>
            <a href={s.href} class="transition-colors hover:text-orange-800 dark:hover:text-orange-400">{s.label}</a>
          </li>
        ))}
      </ul>
    </footer>
  </div>
</Layout>
