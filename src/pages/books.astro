---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import PageHeader from '../components/PageHeader.astro';
import BookRow from '../components/BookRow.astro';
import { books } from '../data/books';
---

<Layout title="Books" description="What’s on the shelf right now — and why.">
  <Container class="py-16 sm:py-24">
    <PageHeader
      eyebrow="Reading"
      title="Books"
      subtitle="What’s on the shelf right now — the ones I keep returning to, and the ones I’m arguing with."
    />

    <ul role="list" class="mt-14 divide-y divide-stone-200 dark:divide-stone-800">
      {books.map((b) => (
        <li class="py-7">
          <BookRow title={b.title} author={b.author} note={b.note} />
        </li>
      ))}
    </ul>
  </Container>
</Layout>
