---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  class?: string;
}
const { eyebrow, title, subtitle, class: className } = Astro.props;
---

<header class:list={[className]}>
  {eyebrow && (
    <p class="mb-5 font-mono text-xs tracking-wide text-orange-800 uppercase dark:text-orange-400">{eyebrow}</p>
  )}
  <h1 class="max-w-[20ch] font-serif text-5xl tracking-tight text-balance text-stone-900 dark:text-stone-100 sm:text-6xl md:text-7xl">
    {title}
  </h1>
  {subtitle && (
    <p class="mt-6 max-w-[58ch] text-xl text-pretty text-stone-600 dark:text-stone-400">{subtitle}</p>
  )}
</header>
