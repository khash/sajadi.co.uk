---
import Container from './Container.astro';
import { site, socials } from '../data/site';
---

<footer class="mt-8 border-t border-stone-200 dark:border-stone-800">
  <Container class="flex flex-col gap-6 py-12 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="font-serif text-lg text-stone-900 dark:text-stone-100">{site.name}</p>
      <p class="text-sm text-stone-500 dark:text-stone-400">England &amp; California</p>
    </div>
    <ul role="list" class="flex flex-wrap gap-6 text-sm text-stone-600 dark:text-stone-400">
      {socials.map((s) => (
        <li>
          <a href={s.href} class="font-normal transition-colors hover:text-orange-800 dark:hover:text-orange-400">
            {s.label}
          </a>
        </li>
      ))}
    </ul>
  </Container>
</footer>
