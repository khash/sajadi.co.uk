---
interface Props {
  href?: string;
  variant?: 'primary' | 'link';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', class: className, ...rest } = Astro.props;

const base = 'inline-flex items-center gap-2 text-sm font-medium transition-colors';
const variants = {
  primary:
    'rounded-full bg-stone-900 px-6 py-3 text-stone-50 hover:bg-orange-800 dark:bg-stone-100 dark:text-stone-900 dark:hover:bg-orange-300',
  link: 'text-stone-700 underline decoration-stone-300 underline-offset-4 hover:text-orange-800 hover:decoration-orange-800 dark:text-stone-300 dark:decoration-stone-700 dark:hover:text-orange-400 dark:hover:decoration-orange-400',
};
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={href ? undefined : 'button'}
  class:list={[base, variants[variant], className]}
  {...rest}
>
  <slot />
</Tag>
