---
interface Props {
  title: string;
  author: string;
  note?: string;
  class?: string;
}
const { title, author, note, class: className } = Astro.props;
---

<div class:list={[className]}>
  <p class="font-serif text-xl text-stone-900 dark:text-stone-100">{title}</p>
  <p class="text-sm text-stone-500 dark:text-stone-400">{author}</p>
  {note && <p class="mt-1 max-w-[48ch] text-base text-pretty text-stone-500 dark:text-stone-400">{note}</p>}
</div>
