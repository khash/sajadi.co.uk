---
interface Props {
  title: string;
  show: string;
  meta: string;
  class?: string;
}
const { title, show, meta, class: className } = Astro.props;
---

<div class:list={['flex flex-col gap-3 bg-stone-50 p-7 dark:bg-stone-950', className]}>
  <p class="font-mono text-xs tracking-wide text-orange-800 uppercase dark:text-orange-400">{show}</p>
  <h3 class="font-serif text-2xl text-stone-900 dark:text-stone-100">{title}</h3>
  <p class="mt-auto text-sm text-stone-500 dark:text-stone-400">{meta}</p>
</div>
