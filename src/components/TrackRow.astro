---
interface Props {
  title: string;
  meta: string;
  len: string;
  class?: string;
}
const { title, meta, len, class: className } = Astro.props;
---

<button
  type="button"
  class:list={[
    'group flex w-full items-center gap-4 rounded-lg px-3 py-3 text-left transition-colors hover:bg-stone-100 dark:hover:bg-stone-900',
    className,
  ]}
>
  <span class="flex size-9 shrink-0 items-center justify-center rounded-full border border-stone-300 text-stone-400 transition-colors group-hover:border-orange-800 group-hover:text-orange-800 dark:border-stone-700 dark:text-stone-500 dark:group-hover:border-orange-400 dark:group-hover:text-orange-400">
    <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
      <path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86A1 1 0 0 0 8 5.14Z" />
    </svg>
  </span>
  <span class="min-w-0 flex-1">
    <span class="block font-serif text-xl text-stone-900 dark:text-stone-100">{title}</span>
    <span class="block text-sm text-stone-500 dark:text-stone-400">{meta}</span>
  </span>
  <span class="font-mono text-xs tabular-nums text-stone-400 dark:text-stone-500">{len}</span>
</button>
